#!/bin/sh
# TRUST-NG metrics sampler: snapshot counter unbound -> SQLite (arsip riwayat)
DB=${TRUSTNG_METRICS_DB:-/var/lib/trustng-metrics/metrics.db}
S=$(/usr/local/sbin/unbound-control stats_noreset 2>/dev/null)
[ -n "$S" ] || exit 1
get() { echo "$S" | awk -F= -v k="$1" '$1==k{print int($2); found=1; exit} END{if(!found) print 0}'; }
TS=$(date +%s)
sqlite3 "$DB" "
CREATE TABLE IF NOT EXISTS metrics_raw(
  ts INTEGER PRIMARY KEY,
  num_queries INTEGER, num_blacklist INTEGER, num_cachehits INTEGER,
  num_cachemiss INTEGER, num_recursivereplies INTEGER, num_prefetch INTEGER,
  queries_ip_ratelimited INTEGER, uptime INTEGER);
CREATE INDEX IF NOT EXISTS idx_metrics_ts ON metrics_raw(ts);
INSERT INTO metrics_raw(ts,num_queries,num_blacklist,num_cachehits,num_cachemiss,
    num_recursivereplies,num_prefetch,queries_ip_ratelimited,uptime)
VALUES($TS,$(get total.num.queries),$(get total.num.blacklist),$(get total.num.cachehits),
    $(get total.num.cachemiss),$(get total.num.recursivereplies),$(get total.num.prefetch),
    $(get total.num.queries_ip_ratelimited),$(get time.up));
DELETE FROM metrics_raw WHERE ts < $TS - 7776000;
"
