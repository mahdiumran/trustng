@@ -0,0 +1,31 @@
+/*
+ * services/filterdb.h - domain blacklist CDB database
+ *
+ * TRUST-NG patch: mmap'ed constant database (CDB) of blacklisted domain
+ * names in DNS wire format. Checked by local_zones_answer() before a
+ * "blacklist." zone falls through to recursion. The database file can be
+ * replaced atomically (rename) by an external updater; workers detect the
+ * new inode via fdb_remap_check() and remap without a reload, keeping
+ * cache and statistics intact.
+ */
+#ifndef SERVICES_FILTERDB_H
+#define SERVICES_FILTERDB_H
+
+struct filter_db;
+
+/** open (mmap) the cdb at path; returns NULL on error. */
+struct filter_db* fdb_open(const char* path);
+
+/** close and free. */
+void fdb_close(struct filter_db* db);
+
+/** stat() the path; if inode differs from the mapped one, remap.
+ *  returns 1 if remapped, 0 if unchanged, -1 on error. */
+int fdb_remap_check(struct filter_db* db);
+
+/** look up qname (uncompressed wire format) with parent-walk so that
+ *  a CDB entry for example.com matches www.example.com too.
+ *  returns 1 if blacklisted, 0 if not, -1 on error/no db. */
+int fdb_check(struct filter_db* db, const uint8_t* dname, size_t dlen);
+
+#endif /* SERVICES_FILTERDB_H */
