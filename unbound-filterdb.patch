+/*
+ * services/filterdb.c - domain blacklist CDB database (TRUST-NG patch)
+ *
+ * Implements a read-only reader for the cdb (constant database) format as
+ * produced by tools like djbdns' cdb_make, blcreate, or the bundled
+ * create_domain_cdb.py. Keys are domain names in DNS wire format
+ * (e.g. \x07example\x03com\x00), values are empty.
+ *
+ * CDB layout (all little endian uint32):
+ *   0   .. 2047 : 256 hash table pointers (pos, num_slots)
+ *   data records: klen(4) dlen(4) key dlen
+ *   hash tables : slots of (hash, pos), pos==0 means empty
+ */
+
+#include "config.h"
+#include "services/filterdb.h"
+#include "util/log.h"
+#include "util/net_help.h"
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <sys/mman.h>
+#ifdef HAVE_SYS_STAT_H
+#include <sys/stat.h>
+#endif
+#ifdef HAVE_UNISTD_H
+#include <unistd.h>
+#endif
+#include <fcntl.h>
+
+#ifndef MAP_FAILED
+#define MAP_FAILED ((void*)-1)
+#endif
+#ifndef PROT_READ
+#define PROT_READ 0x1
+#endif
+#ifndef MAP_SHARED
+#define MAP_SHARED 0x01
+#endif
+
+struct filter_db {
+	uint8_t* map;
+	size_t size;
+	ino_t ino;
+	char* path;
+};
+
+/* little endian readers */
+static uint32_t
+fdb_le32(const uint8_t* p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	       ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+struct filter_db*
+fdb_open(const char* path)
+{
+	struct filter_db* db;
+	int fd;
+	struct stat st;
+	void* map;
+
+	if(!path || !*path)
+		return NULL;
+	fd = open(path, O_RDONLY | O_CLOEXEC);
+	if(fd == -1) {
+		log_err("cannot open filter-database %s: %s", path,
+			strerror(errno));
+		return NULL;
+	}
+	if(fstat(fd, &st) == -1 || st.st_size < 2048) {
+		log_err("cannot stat filter-database %s: %s", path,
+			strerror(errno));
+		close(fd);
+		return NULL;
+	}
+	map = mmap(NULL, (size_t)st.st_size, PROT_READ, MAP_SHARED, fd, 0);
+	if(map == MAP_FAILED) {
+		log_err("cannot map filter-database %s: %s", path,
+			strerror(errno));
+		close(fd);
+		return NULL;
+	}
+	close(fd);
+	db = (struct filter_db*)calloc(1, sizeof(*db));
+	if(!db) {
+		munmap(map, (size_t)st.st_size);
+		return NULL;
+	}
+	db->map = (uint8_t*)map;
+	db->size = (size_t)st.st_size;
+	db->ino = st.st_ino;
+	db->path = strdup(path);
+	log_nametypeclass(VERB_OPS, "filter-database mapped", NULL, 0, 0);
+	return db;
+}
+
+void
+fdb_close(struct filter_db* db)
+{
+	if(!db) return;
+	if(db->map && db->size)
+		munmap((void*)db->map, db->size);
+	free(db->path);
+	free(db);
+}
+
+int
+fdb_remap_check(struct filter_db* db)
+{
+	struct stat st;
+	if(!db || !db->path)
+		return -1;
+	if(stat(db->path, &st) == -1)
+		return -1; /* updater may be mid-rename; keep old map */
+	if(st.st_ino == db->ino)
+		return 0;
+	/* new inode: remap atomically from the same struct */
+	{
+		int fd = open(db->path, O_RDONLY | O_CLOEXEC);
+		void* map;
+		if(fd == -1)
+			return -1;
+		if(fstat(fd, &st) == -1 || st.st_size < 2048) {
+			close(fd);
+			return -1;
+		}
+		map = mmap(NULL, (size_t)st.st_size, PROT_READ, MAP_SHARED,
+			fd, 0);
+		close(fd);
+		if(map == MAP_FAILED)
+			return -1;
+		munmap((void*)db->map, db->size);
+		db->map = (uint8_t*)map;
+		db->size = (size_t)st.st_size;
+		db->ino = st.st_ino;
+		verbose(VERB_OPS, "filter-database remapped: %s", db->path);
+		return 1;
+	}
+}
+
+/* DJB2 hash used by cdb */
+static uint32_t
+cdb_hash(const uint8_t* key, size_t klen)
+{
+	uint32_t h = 5381;
+	size_t i;
+	for(i = 0; i < klen; i++)
+		h = ((h << 5) + h) ^ key[i];
+	return h;
+}
+
+/* find exact wire-format key in the cdb; 1 hit, 0 miss, -1 error */
+static int
+cdb_find(const struct filter_db* db, const uint8_t* key, size_t klen)
+{
+	uint32_t h = cdb_hash(key, klen);
+	uint32_t tpos, tslots, slot, loop;
+
+	if(klen > (size_t)(db->size))
+		return 0;
+	tpos = fdb_le32(db->map + (h % 256) * 8);
+	tslots = fdb_le32(db->map + (h % 256) * 8 + 4);
+	/* bounds: hash table must lie inside the file */
+	if(tpos == 0 || tslots == 0 ||
+	   (size_t)tpos + (size_t)tslots * 8 > db->size)
+		return 0;
+	slot = (h >> 8) % tslots;
+	for(loop = 0; loop < tslots; loop++) {
+		uint32_t shash, spos;
+		uint32_t klen_r, dlen_r;
+		size_t ent = (size_t)tpos + (size_t)slot * 8;
+		shash = fdb_le32(db->map + ent);
+		spos = fdb_le32(db->map + ent + 4);
+		if(spos == 0)
+			return 0; /* empty slot ends probe */
+		if((size_t)spos + 8 > db->size)
+			return -1;
+		if(shash == h) {
+			klen_r = fdb_le32(db->map + spos);
+			dlen_r = fdb_le32(db->map + spos + 4);
+			if((size_t)spos + 8 + klen_r + dlen_r > db->size)
+				return -1;
+			if(klen_r == (uint32_t)klen &&
+			   memcmp(db->map + spos + 8, key, klen) == 0)
+				return 1;
+		}
+		slot = (slot + 1) % tslots;
+	}
+	return 0;
+}
+
+int
+fdb_check(struct filter_db* db, const uint8_t* dname, size_t dlen)
+{
+	/* parent-walk: www.sub.example.com -> sub.example.com -> example.com */
+	while(dlen >= 1) {
+		int r = cdb_find(db, dname, dlen);
+		if(r != 0)
+			return r; /* hit or hard error */
+		if(dname[0] == 0)
+			break; /* root reached */
+		/* strip leftmost label */
+		{
+			size_t labellen = dname[0];
+			if(labellen + 1 >= dlen)
+				break;
+			dname += labellen + 1;
+			dlen -= labellen + 1;
+		}
+	}
+	return 0;
+}
