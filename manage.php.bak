<?php
error_reporting(0);

if ($index != 'yes') exit(0);
include_once 'menu.php';

$myip = $_SERVER['SERVER_ADDR'];
$myv = file_get_contents('/etc/myversion');
$ipaddr = shell_exec("ifconfig eth0 | grep netmask | sed 's/ .*inet //;s/ .*//'");
$ip6 = `ifconfig eth0 | grep inet6 | grep global | head -1 | sed 's/.*inet6 //;s/ .*//'`;
$mystatus = file_get_contents('/run/unbound.status');
$netstatus = file_get_contents('/run/network.status');
$truststatus = file_get_contents('/run/trust.status');
$extip = file_get_contents('/run/extip');
$uptime = shell_exec("uptime");
$model = file_get_contents('/etc/mymodel');

$statusText = function($value) {
    $value = trim((string)$value);
    return $value === '' ? 'Tidak tersedia' : htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
};

$resourceItems = array();
$gaugeData = file_get_contents('gauge.dat');
if (preg_match_all("/\\['([^']+)'\\s*,\\s*([0-9.]+)\\]/", $gaugeData, $matches, PREG_SET_ORDER)) {
    foreach ($matches as $match) {
        if ($match[1] == 'Label') continue;
        $resourceItems[] = array($match[1], min(100, max(0, floatval($match[2]))));
    }
}

$resourceIcon = function($label) {
    $icons = array(
        'RAM' => 'fa-memory',
        'CPU' => 'fa-microchip',
        'Load' => 'fa-wave-square',
        'Disk' => 'fa-hard-drive',
        'Iowait' => 'fa-hourglass-half'
    );
    return isset($icons[$label]) ? $icons[$label] : 'fa-server';
};

$resourceState = function($value) {
    if ($value >= 75) return 'critical';
    if ($value >= 50) return 'warning';
    return 'normal';
};

$resourceTitle = function($label) {
    $titles = array(
        'RAM' => 'Available memory in %',
        'CPU' => 'CPU Load',
        'Load' => 'System Load',
        'Disk' => 'Disk usage in %',
        'Iowait' => 'IO wait in %'
    );
    return isset($titles[$label]) ? $titles[$label] : $label;
};

$resourceUnit = function($label) {
    return ($label == 'Load') ? '' : '%';
};

echo '<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<link rel="stylesheet" type="text/css" href="style.css" />
<title>DNS TRUST-NG - MANAGE</title>
<script src="/jquery.min.js"></script>
<script type="text/javascript" src="loader.js"></script>
</head>
<body>';
echo'
<main class="manage-shell hosting-dashboard">
';
trustng_render_sidebar('manage.php');
echo '
<section class="dashboard-main">
<div class="hero-panel">
<div class="hero-copy">
<div>
<a href="/" class="brand-link"><img src="logo-trust-ng.jpg" class="brand-logo" alt="TRUST-NG"></a>
<p class="eyebrow">DNS Control Panel</p>
<h1 class="hero-title">TRUSTNG v'.htmlspecialchars(trim($myv), ENT_QUOTES, 'UTF-8').'</h1>
<p class="hero-subtitle">Dashboard administrasi DNS untuk konfigurasi jaringan, resolver, client, monitoring, dan perawatan sistem.</p>
</div>
<div class="hero-meta">
<span class="meta-pill">IPv4 '.$statusText($ipaddr).'</span>
<span class="meta-pill">IPv6 '.$statusText($ip6).'</span>
<span class="meta-pill">'.$statusText($model).'</span>
</div>
</div>
</div>
<div class="metric-panel">
<div class="panel-heading">
<div>
<p class="panel-title">System Widgets</p>
<h2 class="section-title">Overview realtime</h2>
</div>
<span class="live-pill">LIVE</span>
</div>
<div class="widget-layout">
<div class="gauge-card">
<p class="widget-label">Resource Load</p>
<div class="zabbix-grid">';
foreach ($resourceItems as $resource) {
    $label = htmlspecialchars($resource[0], ENT_QUOTES, 'UTF-8');
    $title = htmlspecialchars($resourceTitle($resource[0]), ENT_QUOTES, 'UTF-8');
    $value = $resource[1];
    $state = $resourceState($value);
    $unit = htmlspecialchars($resourceUnit($resource[0]), ENT_QUOTES, 'UTF-8');
    $displayValue = rtrim(rtrim(number_format($value, 1), '0'), '.');
    echo '<div class="zabbix-tile '.$state.'" data-resource="'.$label.'" data-value="'.$value.'" data-unit="'.$unit.'">
    <div class="zabbix-title"><i class="fa-solid '.$resourceIcon($resource[0]).'" aria-hidden="true"></i><span>'.$title.'</span></div>
    <div class="zabbix-time">'.date('Y-m-d h:i:s A').'</div>
    <svg class="zabbix-chart" viewBox="0 0 320 120" preserveAspectRatio="none" aria-hidden="true">
    <polygon class="zabbix-area" points=""></polygon>
    <polyline class="zabbix-line" points=""></polyline>
    </svg>
    <div class="zabbix-value"><strong>'.$displayValue.'</strong><span>'.$unit.'</span><i class="fa-solid fa-arrow-up"></i></div>
    <div class="zabbix-caption">'.$title.'</div>
    </div>';
}
echo '</div>
</div>
<div class="query-widget">
<div class="query-head">
<span>
<span class="status-label">DNS Queries</span>
<strong id="queryValue">0</strong>
<small id="queryMode">menunggu data</small>
</span>
<span id="queryPulse" class="query-pulse"></span>
</div>
<canvas id="queryChart" width="720" height="230"></canvas>
<div id="statsRaw" class="stats-raw">';
include 's.php';
echo '</div>
</div>
</div>
<div class="status-grid">
<div class="status-card"><span class="status-icon">UN</span><span><span class="status-label">Unbound</span><span class="status-value ok">'.$statusText($mystatus).'</span></span></div>
<div class="status-card"><span class="status-icon">NW</span><span><span class="status-label">Network</span><span class="status-value ok">'.$statusText($netstatus).'</span></span></div>
<div class="status-card"><span class="status-icon">TR</span><span><span class="status-label">Trust+</span><span class="status-value ok">'.$statusText($truststatus).'</span></span></div>
</div>
<div class="status-card"><span class="status-label">External IP</span><span class="status-value">'.$statusText($extip).'</span></div>
<div class="status-card"><span class="status-label">Uptime</span><span class="status-value">'.$statusText($uptime).'</span></div>
<div id="ifstat" class="status-time" title="Server Date and Time Now">';
include 'ifstat.php';
echo '</div>
</div>
</section>
<p class="manage-footer"><small><b>&#169; 2024 Kominfo</b></small></p>
</main>';
include 'ifstat.js';
echo '<script src="dashboard.js"></script>';
?>
